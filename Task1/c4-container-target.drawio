<mxfile host="app.diagrams.net" type="device"><diagram name="C4 Container - Будущее 2.0 через год" id="C4-Container---Будущее-2.0-через-год"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b_cloud" value="Облако (Yandex Cloud, зоны ru-central1-a/b) - отдельные окружения на домен; Terraform, K8s, managed-сервисы" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1680" height="1220" as="geometry"/></mxCell><mxCell id="b_data" value="Платформа данных (общая): портал самообслуживания и Lakehouse" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="1640" height="300" as="geometry"/></mxCell><mxCell id="b_int" value="Интеграционная платформа (общая): события и контракты вместо ESB и логики в DWH" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="1640" height="140" as="geometry"/></mxCell><mxCell id="b_clinic" value="Домен Clinic" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="570" width="520" height="330" as="geometry"/></mxCell><mxCell id="b_fin" value="Домен Fintech (банк)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="860" y="570" width="520" height="330" as="geometry"/></mxCell><mxCell id="b_ai" value="Домен AI" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1400" y="570" width="560" height="330" as="geometry"/></mxCell><mxCell id="b_legacy" value="Legacy - read-only, выводится по мере переноса" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="930" width="1060" height="150" as="geometry"/></mxCell><mxCell id="b_part" value="Новые домены партнёров - по шаблону домена" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1400" y="930" width="560" height="150" as="geometry"/></mxCell><mxCell id="b_ops" value="Сквозные сервисы" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="1110" width="1640" height="120" as="geometry"/></mxCell><mxCell id="mgr" value="&lt;b&gt;Руководство, бизнес-аналитики&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;отчёты по срезам, свои отчёты&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="ds" value="&lt;b&gt;Data- и ML-инженеры&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;data products, модели&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="100" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Операторы клиник, врачи&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;приём, карты, исследования&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="220" height="110" as="geometry"/></mxCell><mxCell id="bank" value="&lt;b&gt;Клиенты и сотрудники банка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;счета, кредиты&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=mxgraph.c4.person2;align=center;fontColor=#ffffff;fillColor=#08427B;strokeColor=#073B6F;fontSize=11;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="220" height="100" as="geometry"/></mxCell><mxCell id="portal" value="&lt;b&gt;Портал самообслуживания&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[React + Superset, семантический слой (Cube)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;отчёты по срезам, конструктор; RLS по уровню доступа; без медкарт&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="300" height="110" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;Витрины данных&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[ClickHouse managed, RLS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;data marts доменов + общие измерения; отчёт за секунды&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="280" height="110" as="geometry"/></mxCell><mxCell id="airflow" value="&lt;b&gt;Оркестрация и качество&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Airflow, dbt, Great Expectations]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;конвейеры доменов -&amp;gt; витрины&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="280" height="110" as="geometry"/></mxCell><mxCell id="lake" value="&lt;b&gt;Lakehouse&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Object Storage + Iceberg, Trino/Spark]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;raw / prepared; сотни ТБ; retention&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="300" height="110" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;Каталог данных&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[OpenMetadata]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;глоссарий, владельцы, lineage, теги ПДн&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="110" width="360" height="110" as="geometry"/></mxCell><mxCell id="pbi" value="&lt;b&gt;Power BI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[клиент портала]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DirectQuery к витринам, не к DWH&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="300" height="90" as="geometry"/></mxCell><mxCell id="dpstd" value="Стандарт data product: контракт (схема, SLA, владелец, теги ПДн).&lt;br&gt;Каждый домен публикует свои витрины сам через dbt и каталог - DWH не дорабатывается.&lt;br&gt;Новый бизнес = новый домен по шаблону, без изменений платформы." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="580" height="90" as="geometry"/></mxCell><mxCell id="mlp" value="&lt;b&gt;ML-платформа&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[MLflow, feature store, GPU]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;обучение, реестр моделей, мониторинг дрейфа&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="680" height="90" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;b&gt;Событийная платформа&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Kafka managed + Schema Registry]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;события доменов; CDC из legacy (Debezium)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="500" height="90" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;API Gateway + IdP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[APISIX, Keycloak, OPA]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;контракты доменов, OAuth2/OIDC, RBAC/ABAC&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="500" height="90" as="geometry"/></mxCell><mxCell id="cdc" value="&lt;b&gt;CDC / адаптеры legacy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Debezium, коннекторы]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DWH и ESB -&amp;gt; события и Lakehouse&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="430" width="520" height="90" as="geometry"/></mxCell><mxCell id="cui" value="&lt;b&gt;Веб-интерфейс оператора&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[React (замена PowerBuilder)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;приём, карты, снимки&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="610" width="240" height="100" as="geometry"/></mxCell><mxCell id="csvc" value="&lt;b&gt;Сервисы клиники&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Java/Kotlin на K8s]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;пациенты, приёмы, медкарты, исследования&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="610" width="220" height="100" as="geometry"/></mxCell><mxCell id="cdb" value="&lt;b&gt;Clinic OLTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[PostgreSQL managed, шифрование полей]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;медкарты, исследования [medical]&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="760" width="240" height="110" as="geometry"/></mxCell><mxCell id="cobj" value="&lt;b&gt;Снимки и исследования&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Object Storage SSE-KMS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;DICOM, результаты&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="760" width="220" height="110" as="geometry"/></mxCell><mxCell id="fsvc" value="&lt;b&gt;Финтех-сервисы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Go / Java на K8s]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;счета, кредиты, платежи&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="610" width="240" height="100" as="geometry"/>