20" y="235" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg9" value="9. SQL Server 2008 DWH - Hold" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="251" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg10" value="10. Power BI поверх DWH - Hold" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="267" width="370" height="18" as="geometry"/></mxCell><mxCell id="lgq1" value="Приложения и интеграция" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="290" width="360" height="20" as="geometry"/></mxCell><mxCell id="lg11" value="11. Go, Java (Fintech) - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="309" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg12" value="12. Python, FastAPI (AI) - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="325" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg13" value="13. Java/Kotlin (Clinic) - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="341" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg14" value="14. React (UI, портал) - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="357" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg15" value="15. APISIX + Keycloak + OPA - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="373" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg16" value="16. MLflow + feature store - Trial" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="389" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg17" value="17. GraphQL-федерация - Assess" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="405" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg18" value="18. Apach