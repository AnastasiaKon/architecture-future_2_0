width="370" height="18" as="geometry"/></mxCell><mxCell id="lg28" value="28. On-premise серверы - Hold" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="607" width="370" height="18" as="geometry"/></mxCell><mxCell id="lgq3" value="Практики и подходы" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="630" width="360" height="20" as="geometry"/></mxCell><mxCell id="lg29" value="29. Data Mesh / data products - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="649" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg30" value="30. Контракты API и событий - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="665" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg31" value="31. IaC, GitOps - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="681" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg32" value="32. Privacy by Design - Adopt" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="697" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg33" value="33. SLO на домен - Trial" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="713" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg34" value="34. FinOps - Trial" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="729" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg35" value="35. Data contracts автоматизация - Assess" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="745" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg36" value="36. Логика в DWH - Hold" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="761" width="370" height="18" as="geometry"/></mxCell><mxCell id="lg37" value="37. Точка-точка через ESB - Hold" style="text;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="777" width="370" height="18" as="geometry"/></mxCell><mxCell id="foot" value="Adopt - внедряем/используем; Trial - пилот в одном домене; Assess - изучаем; Hold (красный) - не развиваем, выводим." style="text;html=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1105" width="1000" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>